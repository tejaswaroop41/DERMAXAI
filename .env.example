# DERMAXAI Docker/local environment
SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=false

# Backend runtime paths inside the Docker container
MODEL_PATH=/data/models/best.pth
DATABASE_URL=sqlite:////data/dermaxai.db
UPLOADS_DIR=/data/uploads
HEATMAPS_DIR=/data/heatmaps
REPORTS_DIR=/data/generated_reports

# Comma-separated origins. Use http://localhost:5173 for local Docker frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
