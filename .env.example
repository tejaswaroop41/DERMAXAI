# DERMAXAI local/Docker configuration
# Copy this file to .env and replace SECRET_KEY with a long random value.

SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=false
ALLOW_RANDOM_WEIGHTS=false

# Backend runtime paths used by docker-compose.yml
MODEL_PATH=/data/models/best.pth
DATABASE_URL=sqlite:////data/dermaxai.db
UPLOADS_DIR=/data/uploads
HEATMAPS_DIR=/data/heatmaps
REPORTS_DIR=/data/generated_reports

# Comma-separated origins. Use http://localhost:5173 for local Docker frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
