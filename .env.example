# DERMAXAI local/Docker configuration
# Copy this file to .env and replace SECRET_KEY with a long random value.

SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=false
ALLOW_RANDOM_WEIGHTS=false

# Backend runtime paths used by docker-compose.yml
MODEL_PATH=/data/models/best.pth
# Local development / CI default:
DATABASE_URL=sqlite:////data/dermaxai.db
# AWS production: use the private RDS endpoint and keep this secret out of Git.
# Example: postgresql+psycopg2://dermaxai:CHANGE_ME@mydb.xxxxx.region.rds.amazonaws.com:5432/dermaxai?sslmode=require
UPLOADS_DIR=/data/uploads
HEATMAPS_DIR=/data/heatmaps
REPORTS_DIR=/data/generated_reports

# Comma-separated origins. Use http://localhost:5173 for local Docker frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Password reset
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_MINUTES=30

# SMTP. For Gmail, use an App Password rather than your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
