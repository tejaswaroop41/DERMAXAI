# DERMAXAI local/Docker configuration
# Copy this file to .env and change SECRET_KEY before any non-demo deployment.

SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=false

# Backend runtime paths used by docker-compose.yml
MODEL_PATH=/data/models/best.pth
DATABASE_URL=sqlite:////data/dermaxai.db
UPLOADS_DIR=/data/uploads
HEATMAPS_DIR=/data/heatmaps
REPORTS_DIR=/data/generated_reports

# Comma-separated CORS origins for FastAPI
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
