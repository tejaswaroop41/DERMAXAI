# Copy to /opt/dermaxai/.env.production and chmod 600.
# Never commit the populated file.

SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DEBUG=false
ALLOW_RANDOM_WEIGHTS=false

# Use the private RDS endpoint. URL-encode reserved characters in the password.
DATABASE_URL=postgresql+psycopg2://dermaxai:REPLACE_ME@REPLACE_ME.rds.amazonaws.com:5432/dermaxai?sslmode=require

# Artifact storage. Keep the bucket private; access is through the EC2 IAM role.
# Set STORAGE_BACKEND=s3 only after the bucket and IAM policy are ready.
STORAGE_BACKEND=local
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
S3_PREFIX=dermaxai
AWS_REGION=ap-south-1
# Optional for S3-compatible development/testing endpoints.
S3_ENDPOINT_URL=

# Public HTTPS origin of the deployed application.
CORS_ORIGINS=https://REPLACE_WITH_YOUR_DOMAIN
FRONTEND_URL=https://REPLACE_WITH_YOUR_DOMAIN
PASSWORD_RESET_TOKEN_MINUTES=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=REPLACE_ME
SMTP_STARTTLS=true
